# Copy to .env and fill in what you have. Never commit .env (it is gitignored).
# Format: NAME=value, one per line. Names in brackets are accepted aliases
# (packages/core/src/cportal_core/settings.py), so an existing .env keeps working.

# --- General -------------------------------------------------------------------------------
CPORTAL_ENV=dev
# Optional: URL or e-mail appended to the User-Agent. Nominatim and Overpass ask clients to
# identify themselves; leave empty to send only "Cportal/0.1 (<brand> research prototype)".
CPORTAL_CONTACT=
# Q-07: product name shown in the UI and API (the repo codename stays Cportal).
CPORTAL_BRAND_NAME=ShipperFast
# Q-05: display names for the synthetic world: fictional (default) or bd_demo (real, well-known
# Bangladeshi company names for the demo; all figures stay synthetic). config/name_packs/
CPORTAL_NAME_PACK=fictional

# --- Runtime -----------------------------------------------------------------------------------
# Postgres 16 + PostGIS + pgvector. docker compose sets this for the containers; the default
# matches `make db-local` (user-level Postgres, no Docker) and the compose port mapping.
DATABASE_URL=postgresql+psycopg://cportal:cportal@localhost:5432/cportal
# Q-03: local LLM only, any OpenAI-compatible server (Ollama default). Needed from M4 (C2).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b

# --- Maritime --------------------------------------------------------------------------------
# DS-AIS-01 aisstream.io live AIS. Sign up: https://aisstream.io/authenticate (keys: /account)
# Server-side only, never in the browser. [AIS_STREAM_APIKEY, AIS_STREAM_API_KEY]
AISSTREAM_API_KEY=
# DS-AIS-02 / DS-SAT-04 Global Fishing Watch API v3 (CC BY-NC 4.0, non-commercial).
# Token: https://globalfishingwatch.org/our-apis/tokens  [GLOBAL_FISHING_WATCH_GFW_ACCESS_TOKEN, GFW_ACCESS_TOKEN]
GFW_API_TOKEN=

# --- Trade and pharma ------------------------------------------------------------------------
# DS-TRADE-01 UN Comtrade (free "comtrade - v1" product): https://comtradedeveloper.un.org
# [UN_COMTRADE_APIKEY, UN_COMTRADE_API_KEY]
COMTRADE_API_KEY=
# DS-PHARMA-01 openFDA, optional (1,000/day without, 120,000/day with):
# https://open.fda.gov/apis/authentication/  [OPEN_FDA_APIKEY, OPEN_FDA_API_KEY]
OPENFDA_API_KEY=

# --- Vision ------------------------------------------------------------------------------------
# DS-VIS-04 / DS-VIS-05 Roboflow Universe datasets: https://app.roboflow.com (Settings > API)
# [ROBOFLOW_APIKEY]
ROBOFLOW_API_KEY=

# --- Geo, hazards ------------------------------------------------------------------------------
# DS-GEO-03 OpenRouteService HGV. HeiGIT runs ORS, so its dashboard calls this the HeiGIT key:
# https://account.heigit.org  [HEIGIT_KEY, HEIGIT_API_KEY]
ORS_API_KEY=
# DS-WX-05 (proposed) NASA FIRMS active fires, MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# 5,000 transactions per 10 minutes.  [NASA_FIRMS_MAPKEY, NASA_FIRMS_MAP_KEY]
FIRMS_MAP_KEY=
# DS-VIS-01 (Kaggle mirror) / DS-SUP-03: Kaggle API token (KGAT_…), https://www.kaggle.com/settings
# (API > Create New Token)  [KAGGLE_APIKEY]
KAGGLE_API_TOKEN=

# --- Not provided yet (sources fall back as config/sources.yaml says) --------------------------
# DS-NEWS-04 ReliefWeb pre-approved appname. Treated as a secret: quotas are per appname.
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# DS-SAT-05 (proposed) NASA Earthdata login token: https://urs.earthdata.nasa.gov
# (LANCE near-real-time downloads need a separate LANCE app key)  [NASA_EARTHDATA_TOKEN]
EARTHDATA_TOKEN=
