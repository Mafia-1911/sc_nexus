{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cportal:raw/DS-RISK-01",
  "title": "DS-RISK-01 · WGI, INFORM Risk, ND-GAIN: raw responses as observed by the M0 probe",
  "description": "Inferred with genson from saved probe responses. One $defs entry per call.",
  "$defs": {
    "wgi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "key",
                "value"
              ]
            }
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}
