# Secrets (AGENTS.md rule 8)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Data zones (02-architecture.md §8): raw and lake stay local; samples are committed
data/raw/
data/lake/
data/synthetic/
data/cache/

# Model artifacts are fetched, not committed (02-architecture.md §4)
models/**/*.onnx
models/**/*.pt
models/**/*.joblib
models/**/*.bin

# Web
node_modules/
.next/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Manual drops (e.g. CPA berthing PDFs) before parsing; parsed copies go to data/raw
data/inbox/

# C5 gallery (NC dataset thumbnails, heatmaps) and model banks
data/c5/
models/**/*.npz
models/c5/

# DataDocked lookups hold company contact details (A-104): never committed
data/samples/DS-VSL-01/
# Offline basemap (docs/USER_TASKS.md): large downloaded files, never committed
apps/web/public/map/
