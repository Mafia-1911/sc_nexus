# Copy to .env and fill in what you have. Never commit .env (it is gitignored).
# Format: NAME=value, one per line. Names in brackets are accepted aliases
# (packages/core/src/cportal_core/settings.py), so an existing .env keeps working.

# --- General -------------------------------------------------------------------------------
CPORTAL_ENV=dev
# Optional: URL or e-mail appended to the User-Agent. Nominatim and Overpass ask clients to
# identify themselves; leave empty to send only "Cportal/0.1 (Supply Chain Nexus research prototype)".
CPORTAL_CONTACT=

# --- Maritime --------------------------------------------------------------------------------
# DS-AIS-01 aisstream.io live AIS. Sign up: https://aisstream.io/authenticate (keys: /account)
# Server-side only, never in the browser. [AIS_STREAM_APIKEY, AIS_STREAM_API_KEY]
AISSTREAM_API_KEY=
# DS-AIS-02 / DS-SAT-04 Global Fishing Watch API v3 (CC BY-NC 4.0, non-commercial).
# Token: https://globalfishingwatch.org/our-apis/tokens  [GLOBAL_FISHING_WATCH_GFW_ACCESS_TOKEN, GFW_ACCESS_TOKEN]
GFW_API_TOKEN=

# --- Trade and pharma ------------------------------------------------------------------------
# DS-TRADE-01 UN Comtrade (free "comtrade - v1" product): https://comtradedeveloper.un.org
# [UN_COMTRADE_APIKEY, UN_COMTRADE_API_KEY]
COMTRADE_API_KEY=
# DS-PHARMA-01 openFDA, optional (1,000/day without, 120,000/day with):
# https://open.fda.gov/apis/authentication/  [OPEN_FDA_APIKEY, OPEN_FDA_API_KEY]
OPENFDA_API_KEY=

# --- Vision ------------------------------------------------------------------------------------
# DS-VIS-04 / DS-VIS-05 Roboflow Universe datasets: https://app.roboflow.com (Settings > API)
# [ROBOFLOW_APIKEY]
ROBOFLOW_API_KEY=

# --- Not provided yet (sources fall back as config/sources.yaml says) --------------------------
# DS-GEO-03 OpenRouteService HGV: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# DS-NEWS-04 ReliefWeb pre-approved appname (an identifier, not a secret):
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# DS-SAT-05 (proposed) NASA Earthdata login token: https://urs.earthdata.nasa.gov
# (LANCE near-real-time downloads need a separate LANCE app key)  [NASA_EARTHDATA_TOKEN]
EARTHDATA_TOKEN=
