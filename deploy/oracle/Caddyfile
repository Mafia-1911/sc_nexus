# HTTPS for the API (Let's Encrypt, automatic) on API_HOST, e.g. 203.0.113.7.sslip.io, which
# resolves to the VM's IP: no domain needed. Only requests with the shared API token pass; the
# website sends it server-side (API_TOKEN), so the API is not public.
{$API_HOST} {
	@authorized header Authorization "Bearer {$API_TOKEN}"
	handle @authorized {
		reverse_proxy api:8000
	}
	respond "unauthorized" 401
}
