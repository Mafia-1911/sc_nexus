# Cportal (product brand: ShipperFast, CPORTAL_BRAND_NAME).
.DEFAULT_GOAL := help
UV ?= uv
DS ?=

.PHONY: help setup test lint fmt type check probe probe-p0 probe-p1 cards collect-ais ais-report synth-ais \
	db-local db-local-stop migrate revision ingest seed calibrate api openapi up down seed-docker erd \
	worker web-setup web web-check e2e demo

help: ## List targets
	@grep -E '^[a-z0-9-]+:.*##' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-12s %s\n", $$1, $$2}'

setup: ## Install the uv workspace (Python 3.12 is fetched by uv)
	$(UV) sync

test: ## Run all tests
	$(UV) run pytest

lint: ## Ruff lint, format check and package-boundary contracts
	$(UV) run ruff check .
	$(UV) run ruff format --check .
	$(UV) run lint-imports

fmt: ## Apply ruff fixes and formatting
	$(UV) run ruff check . --fix
	$(UV) run ruff format .

type: ## mypy over the packages
	$(UV) run mypy

check: lint type test web-check ## Everything CI runs

probe: ## Probe one source: make probe DS=DS-WX-01
	@test -n "$(DS)" || (echo "usage: make probe DS=<DS-ID>"; exit 2)
	$(UV) run probe $(DS)

probe-p0: ## Probe every P0 source (skips any probed in the last hour)
	$(UV) run probe --tier P0

probe-p1: ## Probe every P1 source
	$(UV) run probe --tier P1

cards: ## Regenerate all source cards from the latest probe runs (no network)
	$(UV) run probe all --card

collect-ais: ## Long-running DS-AIS-01 collector (Ctrl-C to stop)
	$(UV) run ais-collect

ais-report: ## Coverage of collected AIS (ROOT=data/synthetic/DS-AIS-01/baseline for the twin)
	$(UV) run ais-collect --report $(if $(ROOT),--root $(ROOT),)

synth-ais: ## Synthetic Chattogram AIS for the last 7 days (scenario "baseline", seed 42)
	$(UV) run ais-synth --scenario baseline --hours 168 --seed 42

db-local: ## Start a user-level Postgres 16 + PostGIS + pgvector (no Docker; installs on first run)
	@test -x $$HOME/.local/share/cportal/pg/bin/pg_ctl || bash scripts/db-local.sh install
	@test -f $$HOME/.local/share/cportal/pgdata/PG_VERSION || bash scripts/db-local.sh init
	@bash scripts/db-local.sh start

db-local-stop: ## Stop the user-level Postgres
	bash scripts/db-local.sh stop

migrate: ## Apply Alembic migrations to DATABASE_URL
	$(UV) run alembic -c db/alembic.ini upgrade head

revision: ## New autogenerated migration: make revision MSG="what changed"
	@test -n "$(MSG)" || (echo 'usage: make revision MSG="what changed"'; exit 2)
	$(UV) run alembic -c db/alembic.ini revision --autogenerate -m "$(MSG)"

ingest: ## Replay every source's committed samples into the database (real data, offline)
	$(UV) run ingest --replay all

seed: migrate ## Reference replay + synthetic scenarios (baseline, cyclone_supplier_delay)
	$(UV) run seed

calibrate: ## Port DES vs real marginals → docs/data-sources/CALIBRATION.md
	$(UV) run calibrate

api: ## Run the API with reload on http://127.0.0.1:8000 (docs at /docs)
	$(UV) run uvicorn cportal_api.main:app --reload --port 8000

openapi: ## Write the OpenAPI contract to docs/api/openapi.json
	$(UV) run cportal-api-openapi

worker: ## Run the worker locally (live fetches, AIS replay, outbox jobs; CPORTAL_LIVE=0 to stay offline)
	$(UV) run cportal-worker

web-setup: ## Install the web app and the Playwright browser
	cd apps/web && npm ci && npx playwright install chromium

web: ## Next dev server on http://127.0.0.1:3000 (API_URL defaults to http://127.0.0.1:8000)
	cd apps/web && npm run dev -- -p 3000

web-check: ## Web typecheck and lint
	cd apps/web && npm run typecheck && npm run lint

e2e: ## Playwright smoke test against http://127.0.0.1:3000 (screenshots → docs/screenshots)
	cd apps/web && npx playwright test

up: ## docker compose: db, migrate, api, worker, web (http://127.0.0.1:3000)
	@test -f .env || (cp .env.example .env && echo "created .env from .env.example")
	docker compose up -d --build db migrate api worker web

demo: up seed-docker ## Whole stack plus seeded scenarios; the hero scenario replays on the map
	docker compose restart worker
	@echo "ShipperFast demo: http://127.0.0.1:3000"

down: ## Stop the compose stack (data stays in the pgdata volume)
	docker compose down

seed-docker: ## Seed the compose database (reference replay + scenarios)
	docker compose --profile seed run --rm seed

erd: ## Regenerate docs/ERD.md (Mermaid) from the ORM models
	$(UV) run python -m cportal_core.erd
